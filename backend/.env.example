# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
# SQLite (for development)
SQLALCHEMY_DATABASE_URI=sqlite:///moneymind.db

# PostgreSQL (for production)
# SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost/moneymind

# MySQL (alternative)
# SQLALCHEMY_DATABASE_URI=mysql://username:password@localhost/moneymind

# OpenAI API Key (required for AI chat functionality)
OPENAI_API_KEY=sk-your-openai-api-key-here
